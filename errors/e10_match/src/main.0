fn pick(flag: Bool) -> i32 {
    var out: i32 = 0
    match flag {
        true {
            out = 1
        }
        false {
            out = 2
        }
    }
    return out
}

pub fn main(world: World) -> Void raises {
    if pick(true) == 1 {
        check world.out.write("match ok\n")
    }
}
